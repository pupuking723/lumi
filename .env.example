LUMI_AGENT_API_BASE_URL=http://127.0.0.1:9600
LUMI_AGENT_API_TOKEN=replace-with-goclaw-gateway-token
LUMI_AGENT_USER_ID=user-a
LUMI_AGENT_TENANT_ID=default
LUMI_AGENT_ACCEPT_LANGUAGE=zh
LUMI_AGENT_MODEL=agent:closy
LUMI_AGENT_LIVE_WS_PATH=/v1/closy/live/gemini/ws

# Browser-facing live WebSocket endpoint. Prefer a direct backend/gateway URL
# so Next.js can run with `next dev` / `next start` instead of a custom server.
# The frontend prepares HttpOnly cookies through NEXT_PUBLIC_LUMI_LIVE_SESSION_PATH
# before opening this direct backend websocket.
NEXT_PUBLIC_LUMI_LIVE_WS_URL=ws://127.0.0.1:9600/v1/closy/live/gemini/ws
NEXT_PUBLIC_LUMI_LIVE_SESSION_PATH=/api/live/session
LUMI_LIVE_TOKEN_COOKIE_NAME=lumi_live_token
LUMI_LIVE_USER_COOKIE_NAME=lumi_live_user_id
LUMI_LIVE_TENANT_COOKIE_NAME=lumi_live_tenant_id
# Fallback for same-origin proxy deployments.
NEXT_PUBLIC_LUMI_LIVE_WS_PATH=/api/live/gemini/ws

# Set to "off" to force local mock chat responses during tests.
NEXT_PUBLIC_LUMI_CHAT_PROXY_PATH=/api/chat/completions
NEXT_PUBLIC_LUMI_UPLOAD_PROXY_PATH=/api/chat/attachments/upload

# Google login, matching the ShortArt NextAuth integration.
NEXTAUTH_URL=http://localhost:3100
NEXTAUTH_SECRET=replace-with-a-random-secret
NEXT_PUBLIC_GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_SECRET=replace-with-google-client-secret
